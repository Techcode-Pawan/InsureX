# ============================================================
# InsureX Backend Environment Configuration (.env.example)
# Copy this file to server/.env and supply your local credentials
# ============================================================

# Server Port
PORT=5000

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# Node Environment
NODE_ENV=development

# JWT Secret Key for Authentication
JWT_SECRET=insurex_super_secret_jwt_key_change_in_production_2025!
JWT_EXPIRES_IN=7d

# PostgreSQL Database Connection String (Prisma format)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/insurex_db?schema=public
