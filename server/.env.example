# ============================================================
# InsureX Backend Environment Configuration (.env.example)
# Copy this file to server/.env and supply your local credentials
# ============================================================

# Server Port
PORT=5000

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173
# Also used to build one-time agent invitation / password reset links (use your https:// domain in production).

# Node Environment
NODE_ENV=development

# JWT Secret Key for Authentication
# REQUIRED in production. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret
# Session lifetime. Logout / password change / deactivation revoke tokens immediately.
JWT_EXPIRES_IN=8h

# PostgreSQL Database Connection String (Prisma format)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/insurex_db?schema=public
# Direct (non-pooled) connection used by Prisma Migrate. For local PostgreSQL use the same value as DATABASE_URL.
DIRECT_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/insurex_db?schema=public

# Where uploaded customer documents are stored (outside any public folder). Default: server/uploads
# UPLOAD_DIR=

# Online payment provider name. Leave empty: customers submit bank/UPI transaction references and
# staff verify them in Admin > Verification Queue. No gateway is integrated in this codebase yet.
PAYMENT_GATEWAY_PROVIDER=

# Only for local demo seeding (server/prisma/seed.js). Never set in production.
# SEED_DEMO_PASSWORD=

# Prisma interactive-transaction limits in ms (defaults 10000 / 20000). Remote databases such as
# Neon add ~300 ms per query, which overruns Prisma's own 2s/5s defaults (error P2028).
# DB_TX_MAX_WAIT_MS=10000
# DB_TX_TIMEOUT_MS=20000
# For Neon, also add connect_timeout=15 to DATABASE_URL so cold starts don't fail (P1001).

# Time zone for dashboard date ranges and day/week/month grouping (default Asia/Kolkata)
# APP_TIMEZONE=Asia/Kolkata
